# Backend
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

QDRANT_URL=your_qdrant_cloud_url
QDRANT_API_KEY=your_qdrant_api_key

DEEPSEEK_API_KEY=your_deepseek_api_key

# Observability (optional). Tracing stays off unless LANGSMITH_TRACING is
# truthy AND LANGSMITH_API_KEY is set. The app works normally without both.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=support-knowledge-copilot
# Only needed for a self-hosted LangSmith instance:
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Streamlit frontend
API_BASE_URL=http://127.0.0.1:8000
